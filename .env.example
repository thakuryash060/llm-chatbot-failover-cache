# Comma-separated pool of 2 to 3 LLM API keys (1-based key_id: key_1, key_2, key_3)
LLM_API_KEYS=your_key_1,your_key_2,your_key_3

# LiteLLM model identifier (free-tier model e.g. gemini/gemini-3.5-flash-lite or groq/llama-3.3-70b-versatile)
LLM_MODEL=gemini/gemini-3.5-flash-lite

# SQLite database path (use sqlite:////data/app.db inside Docker volume, or sqlite:///./data/app.db locally)
DATABASE_URL=sqlite:////data/app.db

# Disk cache directory for LiteLLM response cache
CACHE_DIR=/data/cache

# Comma-separated allowed CORS origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Enable X-Simulate-Failure request header support
ENABLE_FAILURE_SIMULATION=true

# Default system prompt used across sessions unless overridden
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise AI assistant.
